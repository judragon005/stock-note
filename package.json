{
  "name": "stock-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start:nas": "node scripts/nas-server.cjs",
    "sync:weekly": "node scripts/market-sync/weekly-lakehouse-sync.cjs",
    "backfill:dividends:10y": "node scripts/market-sync/ingest-tw-corporate-actions.cjs --years=10",
    "test": "vitest run",
    "test:watch": "vitest",
    "guard:pre-push": "node scripts/pre-push-guard.cjs",
    "lint:docs": "node scripts/verify-docs.cjs",
    "sync:us:bootstrap": "node scripts/market-sync/sync-us-market.cjs --mode=bootstrap",
    "sync:us:daily": "node scripts/market-sync/sync-us-market.cjs --mode=daily",
    "audit:us-lakehouse": "node scripts/market-sync/audit-verifier.cjs",
    "backfill:tw:250d": "node scripts/market-sync/backfill-tw-history-web.cjs --days 250",
    "backfill:full": "node scripts/market-sync/backfill-full-market-history.cjs --days 250",
    "sync:incremental": "node scripts/market-sync/backfill-full-market-history.cjs --days=auto",
    "market:backfill-all": "node scripts/market-sync/backfill-full-market-history.cjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.11"
  }
}
